datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  PICKER
  AUDITOR
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  password       String
  name           String
  role           Role            @default(PICKER)
  assignedOrders Order[]
  stockMovements StockMovement[]
  scanEvents     ScanEvent[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("users")
}

model Warehouse {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  address   String?
  rows      Row[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("warehouses")
}

model Row {
  id          String     @id @default(uuid())
  code        String
  warehouseId String
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  bins        ShelfBin[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([warehouseId, code])
  @@map("rows")
}

model ShelfBin {
  id            String          @id @default(uuid())
  code          String
  qrCode        String          @unique
  rowId         String
  row           Row             @relation(fields: [rowId], references: [id], onDelete: Cascade)
  zone          String?
  capacity      Int?
  inventories   Inventory[]
  fromMovements StockMovement[] @relation("FromBin")
  toMovements   StockMovement[] @relation("ToBin")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([rowId, code])
  @@map("shelf_bins")
}

model Product {
  id             String          @id @default(uuid())
  sku            String          @unique
  name           String
  description    String?
  category       String?
  price          Decimal         @default(0.0) @db.Decimal(10, 2)
  minStockLevel  Int             @default(10)
  unit           String          @default("pcs")
  qrCode         String?         @unique
  barcode        String?
  inventories    Inventory[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("products")
}

model Inventory {
  id               String   @id @default(uuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  binId            String
  bin              ShelfBin @relation(fields: [binId], references: [id], onDelete: Cascade)
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0)
  updatedAt        DateTime @updatedAt

  @@unique([productId, binId])
  @@index([productId])
  @@index([binId])
  @@map("inventories")
}

enum OrderStatus {
  PENDING
  PICKING
  PICKED
  COMPLETED
  CANCELLED
}

enum OrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Order {
  id               String          @id @default(uuid())
  orderNumber      String          @unique
  customerName     String
  status           OrderStatus     @default(PENDING)
  priority         OrderPriority   @default(NORMAL)
  assignedToUserId String?
  assignedTo       User?           @relation(fields: [assignedToUserId], references: [id])
  items            OrderItem[]
  movements        StockMovement[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("orders")
}

enum OrderItemStatus {
  PENDING
  PICKED
  SHORTAGE
}

model OrderItem {
  id             String          @id @default(uuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  quantity       Int
  pickedQuantity Int             @default(0)
  status         OrderItemStatus @default(PENDING)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([orderId, productId])
  @@map("order_items")
}

enum MovementType {
  INWARD
  OUTWARD
  TRANSFER
  ADJUSTMENT
}

model StockMovement {
  id        String       @id @default(uuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id])
  type      MovementType
  quantity  Int
  fromBinId String?
  fromBin   ShelfBin?    @relation("FromBin", fields: [fromBinId], references: [id])
  toBinId   String?
  toBin     ShelfBin?    @relation("ToBin", fields: [toBinId], references: [id])
  orderId   String?
  order     Order?       @relation(fields: [orderId], references: [id])
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  reason    String?
  createdAt DateTime     @default(now())

  @@index([productId])
  @@index([createdAt])
  @@map("stock_movements")
}

enum ScanType {
  PRODUCT
  SHELF_BIN
  UNKNOWN
}

enum ScanResult {
  MATCH
  WRONG_PRODUCT
  WRONG_LOCATION
  INVALID_QR
}

model ScanEvent {
  id              String     @id @default(uuid())
  qrCode          String
  scannedType     ScanType
  expectedSku     String?
  scannedSku      String?
  expectedBinCode String?
  scannedBinCode  String?
  verified        Boolean
  reason          ScanResult
  userId          String?
  user            User?      @relation(fields: [userId], references: [id])
  metadata        String?
  createdAt       DateTime   @default(now())

  @@index([createdAt])
  @@map("scan_events")
}
