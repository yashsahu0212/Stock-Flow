# Stock Flow - Environment Variables

# Supabase PostgreSQL Connection String (Transaction pooler via Supavisor, port 6543)
# Used by runtime application queries and serverless deployments (Vercel)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection String (Session mode, port 5432)
# Used for Prisma migrations and schema push
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# Supabase Project Credentials (Optional - for Supabase Auth, Storage, Realtime)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

PORT=5000
JWT_SECRET="stockflow-hackathon-super-secret-jwt-key-2026"
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"
